# Konfigurasi Docker Compose di root (untuk penggunaan lokal).

# Port service yang diekspos ke host
WEB_PORT=4200
API_PORT=3000
POSTGRES_PORT=5432

# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_be

# Secret penandatanganan JWT backend
JWT_SECRET=netcom_dev_secret

# Import dump dataset Olist ke PostgreSQL saat docker compose up
# true = import otomatis di run pertama (sekali saja; ditandai tabel _olist_dump_loaded, up berikutnya otomatis dilewati)
DB_DUMP=true
